<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
        x:Class="SkeuomorphGlyphEditor.MainWindow"
        Title="Glyph Map Editor"
        Width="1180" Height="820"
        MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="18">
        <Border DockPanel.Dock="Top" BorderBrush="#3b3b3b" BorderThickness="1" CornerRadius="10" Padding="12" Background="#1f1f1f">
            <StackPanel Spacing="12">
                <TextBlock Text="Glyph Map Editor" FontSize="18" FontWeight="SemiBold" />

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Layout" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox x:Name="LayoutPicker" Width="180" />
                    </StackPanel>

                    <StackPanel x:Name="StylePickerStack" IsVisible="False">
                        <TextBlock Text="Font style" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox x:Name="StylePicker" Width="220" />
                    </StackPanel>

                    <Button Content="Save to map" Click="SaveButton_Click" Width="140" Height="34" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock x:Name="MaskValueText" FontSize="18" FontWeight="Bold" />
                    <TextBlock x:Name="SegmentLegendText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="0,16,0,0" ColumnDefinitions="420,*">
            <Border Margin="0,0,16,0" BorderBrush="#3b3b3b" BorderThickness="1" CornerRadius="12" Padding="16" Background="#181818">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Character map" FontWeight="SemiBold" />
                        <WrapPanel x:Name="CharacterMapPanel" Orientation="Horizontal" ItemWidth="42" ItemHeight="30" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Tips" FontWeight="SemiBold" />
                        <TextBlock Text="- click segment cells to toggle bits&#10;- choose a character to load it into the editor&#10;- the mask updates while you edit&#10;- save writes directly into the active map file" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderBrush="#535353" BorderThickness="1.5" CornerRadius="14" Padding="16" Background="#1a1a1a">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Border BorderBrush="#2f2f2f" BorderThickness="1" CornerRadius="10" Background="#0d0d0d" Padding="10,8,10,8">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                            <Ellipse Width="10" Height="10" Fill="#f52d2d" Stroke="#7d1b1b" StrokeThickness="1" />
                            <TextBlock Grid.Column="1" Text="Hardware panel" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Grid.Column="2" Width="10" Height="10" Fill="#5ddc62" Stroke="#246a2d" StrokeThickness="1" />

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,10,0,0">
                                <Button Content="⟨" Click="PreviousCharacterButton_Click" Width="34" Height="34" />
                                <TextBox x:Name="CharacterInput" Width="60" MaxLength="1" Text="A" />
                                <Button Content="⟩" Click="NextCharacterButton_Click" Width="34" Height="34" />
                                <CheckBox x:Name="CharacterEnabledToggle" Content="Enabled" IsChecked="True" VerticalAlignment="Center" />
                                <Border x:Name="DirtyStateBorder" Padding="8,4" CornerRadius="6" BorderThickness="1" BorderBrush="#2b6b3d" Background="#123420">
                                    <TextBlock x:Name="DirtyStateText" Text="Saved" FontSize="12" FontWeight="SemiBold" Foreground="#9de7b4" />
                                </Border>
                                <Button Content="Save to map" Click="SaveButton_Click" Width="140" Height="34" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="0,12,0,0" BorderBrush="#2d2d2d" BorderThickness="1" CornerRadius="10" Background="#121212" Padding="8">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <TextBlock Text="Layout is selected above" FontSize="12" Foreground="#c7c7c7" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Margin="0,12,0,0" BorderBrush="#2d2d2d" BorderThickness="2" CornerRadius="16" Background="#0b0b0b" Padding="10">
                        <Border BorderBrush="#3d3d3d" BorderThickness="1" CornerRadius="12" Background="#111111" Padding="12">
                            <Grid x:Name="SegmentGrid" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
